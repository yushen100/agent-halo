{
  "name": "agent-halo-dsh-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 启动时自动拉起 agent-halo，并把会话事件按契约 v1 实时推给光环。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "agent-halo.patch.yml",
    "install.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
